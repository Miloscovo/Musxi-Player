# Exercise the real product page against native fixture data. Never relax clocks,
# retry intervals or public interfaces to make UI assertions pass faster.
if(NOT SCENARIO MATCHES "^(available|current|empty|missing|development|checking|failed|stale|changed|download|download-network|download-checksum|download-install-failed|download-changed)$")
  message(FATAL_ERROR "Unknown update UI scenario: ${SCENARIO}")
endif()
file(READ "${SAMPLE}" fixture)
string(JSON fixture SET "${fixture}" releases 0 body
  [=["## 更新说明\n- 本地更新界面验收\n[普通链接](https://example.invalid)\n<img src=x onerror='throw new Error(123)'>"]=])
if(SCENARIO STREQUAL "current")
  string(JSON fixture SET "${fixture}" current version "\"0.5.0\"")
elseif(SCENARIO STREQUAL "empty")
  string(JSON fixture SET "${fixture}" releases "[]")
elseif(SCENARIO STREQUAL "missing")
  string(JSON fixture SET "${fixture}" releases 0 assets "[]")
elseif(SCENARIO STREQUAL "development")
  string(JSON fixture SET "${fixture}" current releaseBuild false)
elseif(SCENARIO STREQUAL "checking")
  string(JSON fixture SET "${fixture}" fetch delaySeconds 2)
elseif(SCENARIO STREQUAL "failed")
  string(JSON fixture SET "${fixture}" fetch reason "\"timeout\"")
elseif(SCENARIO STREQUAL "stale")
  string(JSON fixture SET "${fixture}" fetch "[{}, {\"reason\":\"timeout\",\"delaySeconds\":1}]")
elseif(SCENARIO STREQUAL "download-network")
  string(JSON fixture SET "${fixture}" download reason "\"network_error\"")
elseif(SCENARIO STREQUAL "download-checksum")
  string(JSON fixture SET "${fixture}" download reason "\"checksum_mismatch\"")
elseif(SCENARIO STREQUAL "download-install-failed")
  string(JSON fixture SET "${fixture}" download launchFails true)
elseif(SCENARIO STREQUAL "changed" OR SCENARIO STREQUAL "download-changed")
  string(JSON newer GET "${fixture}" releases 0)
  string(JSON newer SET "${newer}" id 30)
  string(JSON newer SET "${newer}" tag_name "\"v0.6.0\"")
  string(JSON newer SET "${newer}" html_url "\"https://github.com/Miloscovo/Musxi-Player/releases/tag/v0.6.0\"")
  string(JSON newer SET "${newer}" assets 0 id 130)
  string(JSON newer SET "${newer}" assets 0 name "\"MusxiPlayer-Setup-0.6.0.exe\"")
  string(JSON newer SET "${newer}" assets 0 browser_download_url
    "\"https://github.com/Miloscovo/Musxi-Player/releases/download/v0.6.0/MusxiPlayer-Setup-0.6.0.exe\"")
  if(SCENARIO STREQUAL "download-changed")
    string(JSON newer SET "${newer}" assets 1 id 131)
    string(JSON newer SET "${newer}" assets 1 name "\"MusxiPlayer-Update-0.6.0.json\"")
    string(JSON newer SET "${newer}" assets 1 browser_download_url
      "\"https://github.com/Miloscovo/Musxi-Player/releases/download/v0.6.0/MusxiPlayer-Update-0.6.0.json\"")
  endif()
  string(JSON fixture SET "${fixture}" fetch "[{}, {\"releases\":[${newer}],\"delaySeconds\":1}]")
endif()
file(MAKE_DIRECTORY "${ROOT}")
set(samplePath "${ROOT}/${SCENARIO}.json")
file(WRITE "${samplePath}" "${fixture}")
execute_process(COMMAND "${HOST}" --test-app --cef-smoke "--cef-updates-ui-smoke=${SCENARIO}"
  "--update-fixture=${samplePath}" RESULT_VARIABLE result TIMEOUT 95)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Real update UI (${SCENARIO}) failed: ${result}")
endif()
message(STATUS "Real update UI (${SCENARIO}) passed")
