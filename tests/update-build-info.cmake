if(NOT GIT OR NOT SCRIPT OR NOT ROOT)
  message(FATAL_ERROR "Expected GIT, SCRIPT and ROOT")
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef suffix)
set(work "${ROOT}/identity-${suffix}")
set(source "${work}/source")
file(MAKE_DIRECTORY "${source}/frontend" "${source}/installer" "${source}/src/updates")
file(WRITE "${source}/frontend/package.json" "{\"version\":\"0.4.0\"}\n")
file(WRITE "${source}/installer/MusxiPlayerUpgrade.iss" "#define AppVersion \"0.4.0\"\n")
configure_file("${TEMPLATE}" "${source}/src/updates/build_info.hpp.in" COPYONLY)
function(git_run)
  execute_process(COMMAND "${GIT}" ${ARGN} WORKING_DIRECTORY "${source}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Fixture Git operation failed: ${ARGN}")
  endif()
endfunction()
function(check_identity release success)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DUPDATE_SOURCE=${source}"
    "-DUPDATE_BINARY=${work}/out" -DUPDATE_VERSION=0.4.0 "-DMUSXI_RELEASE_BUILD=${release}" -P "${SCRIPT}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(success AND NOT result EQUAL 0)
    message(FATAL_ERROR "Valid build identity rejected")
  elseif(NOT success AND result EQUAL 0)
    message(FATAL_ERROR "Invalid release identity accepted")
  endif()
endfunction()
git_run(init -q)
git_run(add .)
git_run(-c user.name=Musxi-fixture -c user.email=fixture@example.invalid -c commit.gpgsign=false commit -qm fixture)
check_identity(ON FALSE) # Missing matching tag.
git_run(tag v0.4.0)
check_identity(ON TRUE)
file(READ "${work}/out/generated/update_build_info.hpp" header)
if(NOT header MATCHES "Release=true")
  message(FATAL_ERROR "Tagged release not stamped")
endif()
file(APPEND "${source}/frontend/package.json" " ")
check_identity(ON FALSE) # Dirty after an initially valid configure.
file(WRITE "${source}/frontend/package.json" "{\"version\":\"0.5.0\"}\n")
git_run(add .)
git_run(-c user.name=Musxi-fixture -c user.email=fixture@example.invalid -c commit.gpgsign=false commit -qm next)
check_identity(ON FALSE) # HEAD no longer matches the tag.
git_run(tag -f v0.4.0)
check_identity(ON FALSE) # Matching tag but mismatched frontend version.
check_identity(OFF TRUE)
file(READ "${work}/out/generated/update_build_info.hpp" header)
if(NOT header MATCHES "Release=false")
  message(FATAL_ERROR "Development build incorrectly stamped as release")
endif()
message(STATUS "Tagged/dirty/version-mismatch/development build identity contracts passed")
set(nested "${source}/snapshot")
file(MAKE_DIRECTORY "${nested}/src/updates")
configure_file("${TEMPLATE}" "${nested}/src/updates/build_info.hpp.in" COPYONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DUPDATE_SOURCE=${nested}" "-DUPDATE_BINARY=${work}/nested-out"
  -DUPDATE_VERSION=0.4.0 -DMUSXI_RELEASE_BUILD=OFF -P "${SCRIPT}" RESULT_VARIABLE result)
file(READ "${work}/nested-out/generated/update_build_info.hpp" header)
string(FIND "${header}" "Commit[]=\"unknown\"" unknown_index)
if(NOT result EQUAL 0 OR unknown_index EQUAL -1)
  message(FATAL_ERROR "Source snapshot incorrectly inherited its parent repository identity")
endif()
