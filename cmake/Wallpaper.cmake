enable_language(C)
include(FetchContent)
function(musxi_webp_dependency)
  if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
  endif()
  set(BUILD_SHARED_LIBS OFF)
  foreach(tool ANIM_UTILS CWEBP DWEBP GIF2WEBP IMG2WEBP VWEBP WEBPINFO LIBWEBPMUX WEBPMUX EXTRAS WEBP_JS FUZZTEST)
    set(WEBP_BUILD_${tool} OFF)
  endforeach()
  set(WEBP_USE_THREAD OFF)
  FetchContent_Declare(musxi_webp
    URL https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz
    URL_HASH SHA256=e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564)
  FetchContent_MakeAvailable(musxi_webp)
endfunction()
musxi_webp_dependency()
add_library(musxi_wallpaper STATIC "${PROJECT_SOURCE_DIR}/src/cef/wallpaper_image.cpp")
musxi_standard(musxi_wallpaper 17)
get_target_property(musxi_webp_source webpdecoder SOURCE_DIR)
target_include_directories(musxi_wallpaper PRIVATE "${musxi_webp_source}/src")
target_compile_definitions(musxi_wallpaper PRIVATE UNICODE _UNICODE NOMINMAX)
target_link_libraries(musxi_wallpaper PRIVATE webpdecoder windowscodecs ole32)
